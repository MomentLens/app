# MomentLens environment variables. Names only, never values.
#
# Where the real values live:
#   API + worker, local      .env at the repo root
#   API + worker, server     /srv/momentlens/.env, owned by momentlens, chmod 600 (Handbook §13)
#   Mobile, local            apps/mobile/.env (Expo reads .env from the app folder, not the repo root)
#   Mobile, EAS builds       EAS environment variables, one set per profile in apps/mobile/eas.json
#
# Two Supabase databases, dev and stable, both self-hosted on the server (Handbook §13).
# Local development uses dev. The demo backend and the production EAS profile use stable.
#
# This file starts with the variables the architecture already needs. From here on,
# add a variable in the same commit that first reads it, and delete one nothing reads.

# --- apps/api ------------------------------------------------------------------
# 3000 when empty, which is the port nginx proxies to (Handbook §13)
PORT=
# Where the API reaches Auth. On the server, infra/supabase/setup.sh writes http://127.0.0.1:54321,
# nginx on loopback. A laptop uses the dev server's public https:// address.
SUPABASE_URL=
# The anon JWT, ANON_KEY_ASYMMETRIC in the stack's .env, which setup.sh prints. Public, and the
# same value as EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY. Not an sb_publishable_ key: only the Envoy
# gateway understood those, and D-164 removed it.
SUPABASE_PUBLISHABLE_KEY=
# The API's own Postgres login, momentlens_api, which runs as service_role and so bypasses RLS
# (D-164). Server side only, never in apps/mobile. setup.sh writes 127.0.0.1:5432 on the server.
# A laptop uses 127.0.0.1:15432 through the SSH tunnel in Handbook §13.4.
API_DATABASE_URL=
# The service-role JWT, SERVICE_ROLE_KEY_ASYMMETRIC in the stack's .env. Read only by
# tests/integration/rls.test.ts, for Auth's admin API; the API never reads it. Bypasses RLS and
# Auth's checks. Never on the server's app .env, never in apps/mobile.
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Empty turns Sentry off, which suits tests and most local runs
SENTRY_DSN=
# Tags each event: local, development on the dev server, production on the demo stack
SENTRY_ENVIRONMENT=

# --- worker --------------------------------------------------------------------
# Also reads R2_* and SENTRY_ENVIRONMENT from the section above. A local run reads this root .env
# itself and never overrides a variable already set.
# Postgres connection for the pgmq consumer (Handbook §6), a session connection because the
# worker's advisory lock needs one (D-123). On the server, infra/supabase/setup.sh writes
# 127.0.0.1:5432. A laptop uses 127.0.0.1:15432 through the SSH tunnel in Handbook §13.4 (D-163).
# rls.test.ts also uses it, to run queries as anon and as a signed-in user (D-164).
DATABASE_URL=
# Empty turns the worker's Sentry off. Its own variable, because SENTRY_DSN above is the API's and
# both systemd units read the same /srv/momentlens/.env. Project momentlens-worker (D-123).
WORKER_SENTRY_DSN=

# --- apps/mobile (put these in apps/mobile/.env) --------------------------------
# Anything prefixed EXPO_PUBLIC_ is compiled into the app bundle. Anyone holding the
# APK can read it, so nothing secret goes here.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
# The anon JWT, as SUPABASE_PUBLISHABLE_KEY above (D-164)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Empty turns Sentry off in the app
EXPO_PUBLIC_SENTRY_DSN=
# Tags each event: local on a machine, and the EAS environment name in EAS builds
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
