{
  "name": "momentlens",
  "private": true,
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "prepare": "husky",
    "check:machine": "node scripts/doctor.mjs",
    "docs": "node scripts/doc.mjs",
    "docs:check": "node scripts/doc.mjs check",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,json,yml,yaml,css}": "prettier --write",
    "*.md": "node scripts/doc.mjs check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "supabase": "2.117.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
